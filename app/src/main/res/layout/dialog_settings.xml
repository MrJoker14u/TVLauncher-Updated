<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="#1B2226"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Launcher Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Custom Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Name"
            android:textColor="#B0FFFFFF"
            android:textSize="12sp"/>
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deep"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:layout_marginBottom="14dp"/>

        <!-- Corner Style -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banner Corner Roundness"
            android:textColor="#B0FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <RadioGroup
            android:id="@+id/rgCornerStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">
            <RadioButton
                android:id="@+id/rbCornerNone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sharp (0dp)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
            <RadioButton
                android:id="@+id/rbCornerSharp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slight (10dp)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
            <RadioButton
                android:id="@+id/rbCornerRounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rounded (20dp)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbCornerOval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Oval (30dp)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </RadioGroup>

        <!-- Apps per row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apps per Row"
            android:textColor="#B0FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>
        <RadioGroup
            android:id="@+id/rgColumns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">
            <RadioButton
                android:id="@+id/rbCol4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4 Apps"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
            <RadioButton
                android:id="@+id/rbCol5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 Apps (Standard)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbCol6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="6 Apps"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </RadioGroup>

        <!-- Visual Accent Color Picker Palette -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Accent Theme Color (Click to Pick)"
            android:textColor="#B0FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/paletteColorsRow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:id="@+id/colorCyan"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#00E5FF"
                android:focusable="true"
                android:clickable="true"/>
            <View
                android:id="@+id/colorGold"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#FFC107"
                android:focusable="true"
                android:clickable="true"/>
            <View
                android:id="@+id/colorGreen"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#00E676"
                android:focusable="true"
                android:clickable="true"/>
            <View
                android:id="@+id/colorPurple"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#D500F9"
                android:focusable="true"
                android:clickable="true"/>
            <View
                android:id="@+id/colorOrange"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#FF6D00"
                android:focusable="true"
                android:clickable="true"/>
            <View
                android:id="@+id/colorRed"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#FF1744"
                android:focusable="true"
                android:clickable="true"/>
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbAutoMatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-match buttons &amp; theme to wallpaper"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnChooseWallpaper"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="CHOOSE WALLPAPER"
            android:textColor="#FFFFFF"
            android:background="#2E3B43"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnRemoveWallpaper"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="REMOVE WALLPAPER"
            android:textColor="#FFFFFF"
            android:background="#2E3B43"
            android:layout_marginBottom="18dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANCEL"
                android:textColor="#00E5FF"
                style="?android:attr/borderlessButtonStyle"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVE"
                android:textColor="#00E5FF"
                style="?android:attr/borderlessButtonStyle"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
