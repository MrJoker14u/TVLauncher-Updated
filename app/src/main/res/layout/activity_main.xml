<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110F"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="26dp"
    android:paddingBottom="24dp">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Night, Deep"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relax • Watch • Explore"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="16dp">

            <TextClock
                android:id="@+id/tcClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>

            <TextClock
                android:id="@+id/tcDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM yyyy"
                android:format24Hour="EEE, d MMM yyyy"
                android:textColor="#E0E0E0"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Direct Wi-Fi Quick Button -->
        <TextView
            android:id="@+id/btnWifi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="📶 WI-FI"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp"/>

        <!-- Direct Bluetooth Quick Button -->
        <TextView
            android:id="@+id/btnBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="ᛒ BLUETOOTH"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp"/>

        <!-- Launcher Settings -->
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="LAUNCHER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp"/>

        <!-- TV Settings -->
        <TextView
            android:id="@+id/btnTvSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="TV SETTINGS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="14dp"/>
    </LinearLayout>

    <!-- Apps Grid: Clean full bleed tiles -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/bottomBarLayout"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"/>

    <!-- Bottom Container (Single Inputs Button + Quick Action Buttons) -->
    <RelativeLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <!-- Single Neat Inputs Button (Clicking opens Popup selector) -->
        <TextView
            android:id="@+id/btnInputsMenu"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="📺 INPUT SOURCE ▾"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <!-- Right Side: Boost RAM & Recent Apps Actions -->
        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/btnBoostRam"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="⚡ BOOST RAM"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/btnRecentApps"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="▢ RECENT APPS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
