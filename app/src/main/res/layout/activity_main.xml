<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110F"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Night, Deep"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relax • Watch • Explore"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="20dp">

            <TextClock
                android:id="@+id/tcClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>

            <TextClock
                android:id="@+id/tcDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEE, d MMM yyyy"
                android:format24Hour="EEE, d MMM yyyy"
                android:textColor="#E0E0E0"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Dynamic themed launcher button -->
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="LAUNCHER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="18dp"
            android:layout_marginEnd="10dp"/>

        <!-- Dynamic themed TV settings button -->
        <TextView
            android:id="@+id/btnTvSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="TV SETTINGS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:clickable="true"
            android:paddingHorizontal="18dp"/>
    </LinearLayout>

    <!-- Apps Grid: clipChildren false so zoom never cuts at top -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/bottomBarLayout"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"/>

    <!-- Bottom Container (Inputs + System Monitor) -->
    <RelativeLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <!-- Inputs Container: HDMI 1, HDMI 2, AV, HDMI 3 (USB Removed!) -->
        <LinearLayout
            android:id="@+id/inputsContainer"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_container"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INPUTS"
                android:textSize="12sp"
                android:textColor="#B0FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginEnd="14dp"/>

            <TextView
                android:id="@+id/btnHdmi1"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="HDMI 1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/input_btn_selector"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnHdmi2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="HDMI 2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/input_btn_selector"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnAv"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="AV"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/input_btn_selector"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnHdmi3"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="HDMI 3"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/input_btn_selector"
                android:focusable="true"
                android:clickable="true"/>
        </LinearLayout>

        <!-- Live Status Container (RAM + Storage) -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_container"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvRamUsage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAM 0% (0 MB Free)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/pbRam"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="6dp"
                android:progress="0"
                android:progressTint="#00E5FF"/>

            <TextView
                android:id="@+id/tvStorageUsage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage 0% (0 GB used)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/pbStorage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="3dp"
                android:progress="0"
                android:progressTint="#FFC107"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
